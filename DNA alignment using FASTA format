#!/usr/bin/env python3
"""
Interactive Pairwise Alignment using Biopython

1. Paste multi-FASTA sequences directly into the terminal.
2. End input by typing 'END' on a new line.
3. Perform global pairwise alignment of the first two sequences using Biopython's PairwiseAligner.
"""
import sys
from Bio.Align import PairwiseAligner

def read_fasta_interactive():
    """Read multi-FASTA input until 'END' is entered."""
    print("Paste your multi-FASTA sequences below. End with a line containing 'END':")
    lines = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if line.strip() == 'END':
            break
        lines.append(line)
    return '\n'.join(lines)


def parse_fasta(content: str):
    """Simple FASTA parser yielding (header, seq)."""
    header = None
    seq_chunks = []
    for line in content.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith('>'):
            if header:
                yield header, ''.join(seq_chunks)
            header = line[1:]
            seq_chunks = []
        else:
            seq_chunks.append(line)
    if header:
        yield header, ''.join(seq_chunks)


def main():
    fasta_content = read_fasta_interactive().strip()
    if not fasta_content:
        sys.exit('ERROR: No FASTA input provided.')

    seqs = [seq for _, seq in parse_fasta(fasta_content)]
    if len(seqs) < 2:
        sys.exit('ERROR: Need at least two sequences for alignment.')

    seq1, seq2 = seqs[0], seqs[1]
    aligner = PairwiseAligner()
    aligner.mode = 'global'

    alignments = aligner.align(seq1, seq2)
    top = alignments[0]

    print(f"Score: {top.score}")
    print(top)

if __name__ == '__main__':
    main()
